<Window x:Class="Numismatics.WPF.Views.ExportData.ExportDataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Numismatics.WPF.Views.ExportData"
        mc:Ignorable="d"
        Title="Export data"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>

        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource CheckBoxStyle}">
            <Setter Property="Margin" Value="2,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="20" Height="20" CornerRadius="5"
                                    Background="{StaticResource BrushSurfaceRaised}"
                                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1.4">
                                <Path x:Name="Check" Data="M2,6 L6,10 L14,1" Stroke="{StaticResource BrushTextOnGold}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Visibility="Collapsed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource BrushGold}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushGold}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushGold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernRadioButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource RadioButtonStyle}">
            <Setter Property="Margin" Value="2,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Circle" Width="20" Height="20" CornerRadius="10"
                                    Background="{StaticResource BrushSurfaceRaised}"
                                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1.4">
                                <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{StaticResource BrushTextOnGold}" Visibility="Collapsed"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="{StaticResource BrushGold}"/>
                                <Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource BrushGold}"/>
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource BrushGold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Style="{StaticResource GridContainderStyle}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
                <Label Content="Export data" Style="{StaticResource TitleStyle}" Padding="0"
                       HorizontalContentAlignment="Left" HorizontalAlignment="Left"/>
                <Label Content="Choose what to export and in which format" Style="{StaticResource LabelTitleStyle}"
                       HorizontalContentAlignment="Left" HorizontalAlignment="Left" Padding="2,2,0,0"/>
            </StackPanel>

            <GroupBox Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" Header="Data"
                      Style="{StaticResource ModernGroupBoxStyle}">
                <StackPanel>
                    <CheckBox Content="All" Style="{StaticResource ModernCheckBoxStyle}"
                        IsChecked="{Binding ExportDataViewModel.ExportAll, UpdateSourceTrigger=PropertyChanged}"/>
                    <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4,0,10"/>
                    <CheckBox Content="Banknotes" Style="{StaticResource ModernCheckBoxStyle}"
                        IsChecked="{Binding ExportDataViewModel.ExportBanknotesData, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="Coins" Style="{StaticResource ModernCheckBoxStyle}"
                        IsChecked="{Binding ExportDataViewModel.ExportCoinsData, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="Countries" Style="{StaticResource ModernCheckBoxStyle}"
                        IsChecked="{Binding ExportDataViewModel.ExportCountriesData, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="Currencies" Style="{StaticResource ModernCheckBoxStyle}"
                        IsChecked="{Binding ExportDataViewModel.ExportCurrenciesData, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="Owned banknotes" Style="{StaticResource ModernCheckBoxStyle}"
                        IsChecked="{Binding ExportDataViewModel.ExportOwnedBanknotesData, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="Owned coins" Style="{StaticResource ModernCheckBoxStyle}"
                        IsChecked="{Binding ExportDataViewModel.ExportOwnedCoinsData, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" Header="Export format"
                      Style="{StaticResource ModernGroupBoxStyle}">
                <StackPanel>
                    <RadioButton Content="JSON" Style="{StaticResource ModernRadioButtonStyle}"
                        IsChecked="{Binding ExportDataViewModel.SelectedExportFormat, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Json}"/>
                    <RadioButton Content="CSV" Style="{StaticResource ModernRadioButtonStyle}"
                        IsChecked="{Binding ExportDataViewModel.SelectedExportFormat, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Csv}"/>
                </StackPanel>
            </GroupBox>

            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,0"
                    Style="{StaticResource CardOnDarkStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <Label Content="EXPORT PATH" Style="{StaticResource LabelStyleDark}"/>
                        <TextBox Style="{StaticResource TextBoxInputStyle}"
                                 Text="{Binding ExportDataViewModel.ExportPath, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="Choose path" Style="{StaticResource CrudButtonStyle}"
                            Width="140" VerticalAlignment="Top"
                            Command="{Binding ExportDataViewModel.ChooseExportPathCommand}" Margin="10,21,8,0"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Style="{StaticResource SaveButtonStyle}" Content="Export" Width="160" Height="44" FontSize="14"
                        Command="{Binding ExportDataViewModel.ExportDataCommand}"/>
                <Button Style="{StaticResource ExitButtonStyle}" Content="Exit" Width="140" Height="44" FontSize="14"
                        Click="Exit" Margin="0,0,10,0"/>
            </StackPanel>

        </Grid>
    </Grid>
</Window>
