<Page x:Class="Numismatics.WPF.View.CurrencyView.CurrencyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Numismatics.WPF.View.CurrencyView"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Background="{StaticResource BrushBg}"
      Title="Currency page">

    <Grid Style="{StaticResource GridContainderStyle}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Label Content="Currencies page" Style="{StaticResource TitleStyle}" Padding="0"/>
                <Label Content="{Binding CurrencyDisplayViewModel.TotalCurrenciesText, UpdateSourceTrigger=PropertyChanged}"
                       Style="{StaticResource LabelTitleStyle}" Padding="2,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="+ Add" Style="{StaticResource CrudButtonStyle}" Width="110"
                        Command="{Binding CurrencyDisplayViewModel.AddCurrencyCommand}"/>
                <Button Content="Update" Style="{StaticResource SaveButtonStyle}" Width="110" Height="42"
                        Command="{Binding CurrencyDisplayViewModel.UpdateCurrencyCommand}"/>
                <Button Content="Delete" Style="{StaticResource ExitButtonStyle}" Width="110" Height="42"
                        Command="{Binding CurrencyDisplayViewModel.DeleteCurrencyCommand}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardOnDarkStyle}" Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <Label Content="NAME" Style="{StaticResource LabelStyleDark}"/>
                    <TextBox Style="{StaticResource TextBoxInputStyle}"
                             Text="{Binding CurrencyDisplayViewModel.CurrencySearchDataViewModel.Name, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0" MaxWidth="220" HorizontalAlignment="Left">
                    <Label Content="CODE" Style="{StaticResource LabelStyleDark}"/>
                    <TextBox Style="{StaticResource TextBoxInputStyle}"
                             Text="{Binding CurrencyDisplayViewModel.CurrencySearchDataViewModel.Code, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource IconButtonStyle}" Command="{Binding CurrencyDisplayViewModel.SearchCommand}"
                            ToolTip="Search">
                        <Image Source="/Images/SearchIcon.png" Width="16" Height="16"/>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Command="{Binding CurrencyDisplayViewModel.RefreshSearchCommand}"
                            ToolTip="Reset filters" Margin="8,0,0,0">
                        <Image Source="/Images/RefreshIcon.png" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="Collection" Style="{StaticResource CardHeaderStyle}" Margin="4,22,0,0"/>

        <DataGrid Grid.Row="3"
            Style="{StaticResource ModernDataGridStyle}"
            Margin="0,6,0,0"
            ItemsSource="{Binding CurrencyDisplayViewModel.CurrentCurrencies, UpdateSourceTrigger=PropertyChanged}"
            SelectedItem="{Binding CurrencyDisplayViewModel.SelectedCurrency, UpdateSourceTrigger=PropertyChanged}"
            MouseDoubleClick="ShowCurrency"
            HeadersVisibility="Column"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            CanUserAddRows="False"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <DataGrid.Columns>
                <DataGridTextColumn Header="NAME" Width="3*" Binding="{Binding Name}"
                                    ElementStyle="{StaticResource DataGridTextStyle}" CanUserSort="False"></DataGridTextColumn>
                <DataGridTextColumn Header="MAIN UNIT NAME" Width="2*" Binding="{Binding MainUnitName}"
                                    ElementStyle="{StaticResource DataGridTextStyle}" CanUserSort="False"></DataGridTextColumn>
                <DataGridTextColumn Header="SUBUNIT NAME" Width="2*" Binding="{Binding SubunitName}"
                                    ElementStyle="{StaticResource DataGridTextStyle}" CanUserSort="False"></DataGridTextColumn>
                <DataGridTextColumn Header="CODE" Width="*" Binding="{Binding Code}"
                                    ElementStyle="{StaticResource DataGridTextStyle}" CanUserSort="False"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Text="Double-click a row to open currency details" 
                   Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="4,10,0,0"/>
    </Grid>
</Page>
