<Window x:Class="Numismatics.WPF.View.BanknoteView.BanknoteDetailsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Numismatics.WPF.View.BanknoteView"
        mc:Ignorable="d"
        Title="Banknote details"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxInputStyle}" x:Key="BanknoteTextBoxInputStyle">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxInputStyle}" x:Key="BanknoteComboBoxInputStyle">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Style="{StaticResource GridContainderStyle}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,10" Style="{StaticResource CardOnDarkStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Obverse" Style="{StaticResource CardHeaderStyle}" Margin="0" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Upload" Command="{Binding BanknoteCrudViewModel.AddObversePictureCommand}"
                                    Style="{StaticResource SaveButtonStyle}" Width="90" Height="32" FontSize="12"/>
                            <Button Grid.Column="2" Content="Remove" Command="{Binding BanknoteCrudViewModel.DeleteObversePictureCommand}"
                                    Style="{StaticResource ExitButtonStyle}" Width="90" Height="32" FontSize="12" Margin="8,0,0,0"/>
                        </Grid>

                        <Border Grid.Row="1" Background="{StaticResource BrushNavy}" CornerRadius="10" Padding="14">
                            <Image x:Name="ObversePicture" Stretch="Uniform"
                                   Source="{Binding BanknoteCrudViewModel.CurrentBanknote.ObversePicture, Converter={StaticResource ImagePathToBitmapConverter}}"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardOnDarkStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Reverse" Style="{StaticResource CardHeaderStyle}" Margin="0" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Upload" Command="{Binding BanknoteCrudViewModel.AddReversePictureCommand}"
                                    Style="{StaticResource SaveButtonStyle}" Width="90" Height="32" FontSize="12"/>
                            <Button Grid.Column="2" Content="Remove" Command="{Binding BanknoteCrudViewModel.DeleteReversePictureCommand}"
                                    Style="{StaticResource ExitButtonStyle}" Width="90" Height="32" FontSize="12" Margin="8,0,0,0"/>
                        </Grid>

                        <Border Grid.Row="1" Background="{StaticResource BrushNavy}" CornerRadius="10" Padding="14">
                            <Image x:Name="ReversePicture" Stretch="Uniform"
                                   Source="{Binding BanknoteCrudViewModel.CurrentBanknote.ReversePicture, Converter={StaticResource ImagePathToBitmapConverter}}"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="0" Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Margin="0,0,0,10" Header="Basic information"
                      Style="{StaticResource ModernGroupBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,4">
                            <Label Content="COUNTRY" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Name="CountryComboBox" IsEditable="True" Style="{StaticResource ComboBoxInputStyle}"
                                  ItemsSource="{Binding BanknoteCrudViewModel.AllCountries}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding BanknoteCrudViewModel.SelectedCountry}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,4">
                            <Label Content="CURRENCY" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="CurrencyTextBox" IsEditable="True" Style="{StaticResource ComboBoxInputStyle}"
                                  ItemsSource="{Binding BanknoteCrudViewModel.Currencies}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding BanknoteCrudViewModel.SelectedCurrency}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,4">
                            <Label Content="VALUE" Style="{StaticResource LabelStyle}"/>
                            <TextBox Name="ValueTextBox" TextWrapping="Wrap" Style="{StaticResource BanknoteTextBoxInputStyle}"
                                 Text="{Binding Path=BanknoteCrudViewModel.CurrentBanknote.Value, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                 Validation.ErrorTemplate="{StaticResource ValidationTemplate}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4">
                            <Label Content="UNIT" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Style="{StaticResource ComboBoxInputStyle}"
                                  ItemsSource="{Binding BanknoteCrudViewModel.CurrencyUnitNames, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedItem="{Binding BanknoteCrudViewModel.SelectedCurrencyUnitName}"/>
                        </StackPanel>

                        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <Label Content="DAY" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="IssueDayTextBox" Style="{StaticResource BanknoteTextBoxInputStyle}"
                                     Text="{Binding Path=BanknoteCrudViewModel.CurrentBanknote.Day, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                     Validation.ErrorTemplate="{StaticResource ValidationTemplate}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <Label Content="MONTH" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="IssueMonthTextBox" Style="{StaticResource BanknoteTextBoxInputStyle}"
                                     Text="{Binding Path=BanknoteCrudViewModel.CurrentBanknote.Month,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                     Validation.ErrorTemplate="{StaticResource ValidationTemplate}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="YEAR" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="IssueYearTextBox" Style="{StaticResource BanknoteTextBoxInputStyle}"
                                     Text="{Binding Path=BanknoteCrudViewModel.CurrentBanknote.Year, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                     Validation.ErrorTemplate="{StaticResource ValidationTemplate}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,8,0">
                            <Label Content="ERA" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Name="EraComboBox" Style="{StaticResource ComboBoxInputStyle}"
                                  ItemsSource="{Binding BanknoteCrudViewModel.EraList}"
                                  SelectedItem="{Binding BanknoteCrudViewModel.CurrentBanknote.Era, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2">
                            <Label Content="CITY" Style="{StaticResource LabelStyle}"/>
                            <TextBox Name="CityTextBox" TextWrapping="Wrap" Style="{StaticResource BanknoteTextBoxInputStyle}"
                                 Text="{Binding Path=BanknoteCrudViewModel.CurrentBanknote.City, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                 Validation.ErrorTemplate="{StaticResource ValidationTemplate}"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="1" Margin="0" Header="Additional information"
                      Style="{StaticResource ModernGroupBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.3*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                            <Label Content="DESCRIPTION" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="DescriptionTextBox" Height="70"
                                 Style="{StaticResource TextBoxInputStyle}"
                                 Text="{Binding BanknoteCrudViewModel.CurrentBanknote.Description, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="True"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                            <Label Content="{Binding BanknoteCrudViewModel.NumberOfBanknotes, UpdateSourceTrigger=PropertyChanged}"
                               Style="{StaticResource LabelStyle}"/>
                            <DataGrid x:Name="BanknoteQualityDataGrid" Height="150"
                                  Style="{StaticResource ModernDataGridStyle}"
                                  ItemsSource="{Binding BanknoteCrudViewModel.CurrentBanknote.Banknotes, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=False}"
                                  SelectedItem="{Binding BanknoteCrudViewModel.CurrentBanknote.CurrentOwnedBanknote}"
                                  SelectionMode="Single" AutoGenerateColumns="False"
                                  CanUserAddRows="False" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SERIAL NUMBER" Width="*" Binding="{Binding SerialNumber}" ElementStyle="{StaticResource DataGridTextStyle}"/>
                                    <DataGridTextColumn Header="QUALITY" Width="*" Binding="{Binding Quality}" ElementStyle="{StaticResource DataGridTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>

                        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                            Background="{StaticResource BrushNavy}" CornerRadius="10" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <Label Content="QUALITY" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox x:Name="BanknoteQualityComboBox" Style="{StaticResource ComboBoxInputStyle}"
                                          ItemsSource="{Binding BanknoteCrudViewModel.MoneyQualities}"
                                          SelectedItem="{Binding BanknoteCrudViewModel.CurrentBanknote.CurrentBanknoteQuality}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <Label Content="SERIAL NUMBER" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="BanknoteCodeTextBox" Style="{StaticResource TextBoxInputStyle}"
                                         Text="{Binding BanknoteCrudViewModel.CurrentBanknote.CurrentBanknoteSerialNumber, Mode=TwoWay}"/>
                                </StackPanel>

                                <Button Grid.Column="2" Content="Add" Style="{StaticResource SaveButtonStyle}"
                                    Command="{Binding BanknoteCrudViewModel.AddBanknoteCommand}"
                                    Width="90" VerticalAlignment="Bottom" Margin="0,0,5,0"/>
                                <Button Grid.Column="3" Content="Delete" Style="{StaticResource ExitButtonStyle}"
                                    Command="{Binding BanknoteCrudViewModel.DeleteBanknoteCommand}"
                                    Width="90" VerticalAlignment="Bottom" Margin="0,0,5,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </GroupBox>
            </Grid>

            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Style="{StaticResource SaveButtonStyle}" Content="Save" Width="150" Height="44" FontSize="14"
                        Command="{Binding BanknoteCrudViewModel.CreateBanknoteCommand}"/>
                <Button Style="{StaticResource ExitButtonStyle}" Content="Exit" Width="150" Height="44" FontSize="14"
                        Click="Exit" Margin="0,0,10,0"/>
            </StackPanel>

        </Grid>
    </Grid>
</Window>
